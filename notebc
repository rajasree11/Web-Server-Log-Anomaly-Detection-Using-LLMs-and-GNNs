from sklearn.base import BaseEstimator, ClassifierMixin
import torch
import torch.nn.functional as F
from torch_geometric.data import Data
from torch_geometric.nn import GCNConv
import numpy as np
from sklearn.preprocessing import StandardScaler, LabelEncoder
import pandas as pd
import networkx as nx
import matplotlib.pyplot as plt

class GNNClassifier(torch.nn.Module):
    def __init__(self, in_channels, hidden_channels, out_channels):
        super(GNNClassifier, self).__init__()
        self.conv1 = GCNConv(in_channels, hidden_channels)
        self.conv2 = GCNConv(hidden_channels, hidden_channels)
        self.conv3 = GCNConv(hidden_channels, out_channels)

    def forward(self, x, edge_index):
        x = self.conv1(x, edge_index)
        x = F.relu(x)
        x = self.conv2(x, edge_index)
        x = F.relu(x)
        x = self.conv3(x, edge_index)
        return F.log_softmax(x, dim=1)

class GNNWrapper(BaseEstimator, ClassifierMixin):
    def __init__(self, hidden_channels=32, epochs=100, lr=0.01):
        self.hidden_channels = hidden_channels
        self.epochs = epochs
        self.lr = lr
        self.model = None
        self.scaler = StandardScaler()
        self.label_encoders = {}
        self.edge_index = None

    def _encode_categoricals(self, X):
        X = X.copy()
        for col in X.select_dtypes(include=['object', 'category']).columns:
            if col not in self.label_encoders:
                self.label_encoders[col] = LabelEncoder()
                X[col] = self.label_encoders[col].fit_transform(X[col])
            else:
                X[col] = self.label_encoders[col].transform(X[col])
        return X

    def visualize_graph(self):
        if self.edge_index is None:
            raise ValueError("Graph has not been constructed yet. Fit the model first.")
        G = nx.Graph()
        G.add_edges_from(self.edge_index.t().tolist())
        pos = nx.spring_layout(G, seed=42)
        plt.figure(figsize=(8, 6))
        nx.draw(G, pos, with_labels=True, node_color='skyblue', edge_color='gray')
        plt.title("Graph Visualization")
        plt.show()

    def fit(self, X, y):
        if isinstance(X, pd.DataFrame):
            X = self._encode_categoricals(X)
            X = X.values
        if isinstance(y, pd.Series):
            y = y.values

        self.num_classes = len(np.unique(y))
        self.classes_ = np.unique(y)

        # Scale features
        X_scaled = self.scaler.fit_transform(X)

        self.model = GNNClassifier(
            in_channels=X.shape[1],
            hidden_channels=self.hidden_channels,
            out_channels=self.num_classes
        )

        optimizer = torch.optim.Adam(self.model.parameters(), lr=self.lr, weight_decay=5e-4)
        criterion = torch.nn.CrossEntropyLoss()

        x_tensor = torch.tensor(X_scaled, dtype=torch.float)
        y_tensor = torch.tensor(y, dtype=torch.long)

        edge_index = []
        for i in range(len(X)):
            for j in range(len(X)):
                if i != j and abs(i - j) <= 5:
                    edge_index.append([i, j])

        if len(edge_index) == 0:
            edge_index = [[i, i] for i in range(len(X))]

        self.edge_index = torch.tensor(edge_index, dtype=torch.long).t().contiguous()

        for epoch in range(self.epochs):
            self.model.train()
            optimizer.zero_grad()
            out = self.model(x_tensor, self.edge_index)
            loss = criterion(out, y_tensor)
            loss.backward()
            optimizer.step()

        return self

    def predict(self, X):
        if isinstance(X, pd.DataFrame):
            X = self._encode_categoricals(X)
            X = X.values

        X_scaled = self.scaler.transform(X)

        self.model.eval()
        x_tensor = torch.tensor(X_scaled, dtype=torch.float)

        edge_index = []
        for i in range(len(X)):
            for j in range(len(X)):
                if i != j and abs(i - j) <= 5:
                    edge_index.append([i, j])

        if len(edge_index) == 0:
            edge_index = [[i, i] for i in range(len(X))]

        edge_index = torch.tensor(edge_index, dtype=torch.long).t().contiguous()

        with torch.no_grad():
            out = self.model(x_tensor, edge_index)
            pred = out.argmax(dim=1).numpy()

        if not hasattr(self, 'classes_'):
            self.classes_ = np.unique(pred)

        return pred

    def predict_proba(self, X):
        if isinstance(X, pd.DataFrame):
            X = self._encode_categoricals(X)
            X = X.values

        X_scaled = self.scaler.transform(X)

        self.model.eval()
        x_tensor = torch.tensor(X_scaled, dtype=torch.float)

        edge_index = []
        for i in range(len(X)):
            for j in range(len(X)):
                if i != j and abs(i - j) <= 5:
                    edge_index.append([i, j])

        if len(edge_index) == 0:
            edge_index = [[i, i] for i in range(len(X))]

        edge_index = torch.tensor(edge_index, dtype=torch.long).t().contiguous()

        with torch.no_grad():
            out = self.model(x_tensor, edge_index)
            prob = torch.softmax(out, dim=1).numpy()

        if not hasattr(self, 'classes_'):
            self.classes_ = np.arange(prob.shape[1])

        return prob

    def get_params(self, deep=True):
        return {
            'hidden_channels': self.hidden_channels,
            'epochs': self.epochs,
            'lr': self.lr
        }

    def set_params(self, **params):
        for param, value in params.items():
            setattr(self, param, value)
        return self

